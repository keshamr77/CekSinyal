# Contoh secrets dashboard CekSinyal. SEMUA NILAI DI SINI PLACEHOLDER.
#
# Lokal : salin menjadi .streamlit/secrets.toml (file itu di-.gitignore, JANGAN di-commit).
# Cloud : tempel isinya (yang sudah diisi) di App settings -> Secrets pada Streamlit Community Cloud.

[dashboard]
# Bagian URL spreadsheet bersama di antara /d/ dan /edit
spreadsheet_id = "ID_SPREADSHEET_ANDA"
# mode = "sheets"            # bawaan "auto": sheets kalau spreadsheet_id dan kredensial ada
# public = true              # bawaan true: nama kos selalu diganti alias
# stale_minutes = 15         # peringatan "alat ukur diam"
# cache_ttl_seconds = 300    # jeda baca ulang Sheets (hemat kuota)
# timezone_offset_hours = 7  # WIB

# Nama kos asli (persis seperti kolom `kos` di data) -> alias yang tampil.
# Kos yang tidak terdaftar di sini otomatis menjadi "Kos 1", "Kos 2", ... dalam mode publik.
[kos_aliases]
"nama-kos-asli-1" = "Kos A"
"nama-kos-asli-2" = "Kos B"

# Opsional: hanya kalau ambang diagnosis di config.yaml tim sudah diubah dari bawaannya.
# [diagnosis]
# rsrp_weak_dbm = -110
# sinr_interference_db = 0

# Isi file JSON service account KHUSUS BACA (spreadsheet di-share ke email ini sebagai Viewer).
[gcp_service_account]
type = "service_account"
project_id = "nama-project"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nISI_KUNCI_PRIVAT\n-----END PRIVATE KEY-----\n"
client_email = "dashboard-baca@nama-project.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/dashboard-baca%40nama-project.iam.gserviceaccount.com"
