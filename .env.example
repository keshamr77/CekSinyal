# Salin ke .env lalu isi. File .env JANGAN di-commit.

# Bot Telegram: token dari @BotFather, chat ID grup/akun tujuan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets: path file JSON service account (relatif terhadap folder config.yaml, atau absolut).
GOOGLE_CREDENTIALS_FILE=
# Opsional: ID spreadsheet bersama (bisa juga diisi di config.yaml, sheets.spreadsheet_id).
GOOGLE_SPREADSHEET_ID=
